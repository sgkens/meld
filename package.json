{
  "name": "@meldjs/meld",
  "version": "1.4.0",
  "description": "The 2kb Micro-Frontend Engine",
  "license": "MIT",
  "type": "module",
  "main": "dist/meld.core.js",
  "module": "dist/meld.core.esm.js",
  "types": "src/meld.d.ts",
  "jsdelivr": "dist/meld.core.min.js",
  "unpkg": "dist/meld.core.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meldjs/meld.git"
  },
  "homepage": "https://meldjs.dev",
  "exports": {
    ".": {
      "types": "./src/meld.d.ts",
      "import": "./dist/meld.core.esm.js",
      "default": "./dist/meld.core.esm.js"
    },
    "./core": {
      "types": "./src/meld.d.ts",
      "import": "./dist/meld.core.esm.js",
      "default": "./dist/meld.core.esm.js"
    },
    "./plugins/*": "./src/plugins/meld-*.js",
    "./components/*": "./src/components/*",
    "./bin/*": "./bin/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "meld-artisan": "./bin/meld-artisan.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "serve": "vite --host 0.0.0.0",
    "docs": "npm run docs:serve",
    "docs:build": "eleventy --config=eleventy.config.js --input=docs --output=_site",
    "docs:serve": "eleventy --config=eleventy.config.js --input=docs --output=_site --serve --watch",
    "build:docs": "npm run docs:build"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "package.json",
    "meld-env.d.ts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie < 11"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/meld.core.js",
      "src/plugins/*.js"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.devops-templates/",
      "<rootDir>/automator-devops/",
      "<rootDir>/CONTEXT-SOURCE/",
      "<rootDir>/dist/",
      "<rootDir>/meld-vscode/",
      "<rootDir>/meld-lsp/"
    ]
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "marked": "^12.0.0",
    "puppeteer": "^22.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^5.0.0"
  }
}
