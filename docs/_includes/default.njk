<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or "Docs" }} | Meld.js</title>
    <meta name="description" content="{{ description or 'Meld.js documentation — a 2kb micro-frontend engine for reactive state, native custom elements, and plugin-driven integration.' }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/prism-meld.css">
    <link rel="stylesheet" href="/assets/docs.css">
    {# Block flash of wrong theme #}
    <script>document.documentElement.dataset.theme = localStorage.getItem('meld-docs-theme') || 'dark';</script>
    {# Third-party libs #}
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" defer></script>
    {# Docs JS #}
    <script src="/assets/docs.js" defer></script>
  </head>
  <body>
    {# Ambient background grid #}
    <div class="space-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>

    <aside
      class="release-banner"
      data-release-banner
      data-release-id="{{ releaseBanner.id or 'meld-launch-2026-07' }}"
      aria-label="Release notice"
    >
      <div class="release-banner__inner">
        <span class="release-banner__eyebrow">{{ releaseBanner.eyebrow or 'Release' }}</span>
        <p>{{ releaseBanner.message or 'Meld.js launch notes, benchmark harness updates, and websocket plugin status are available in the release notes.' }}</p>
        <a href="{{ releaseBanner.href or '/releases/' }}">{{ releaseBanner.linkText or 'View details' }}</a>
        <button type="button" class="release-banner__dismiss" data-release-banner-dismiss aria-label="Dismiss release notice">
          <i data-lucide="x"></i>
        </button>
      </div>
    </aside>

    {# ── Topbar ─────────────────────────────────────────────────── #}
    <header class="site-topbar">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 120 120" width="36" height="36" xmlns="http://www.w3.org/2000/svg" aria-label="Meld.js logo" role="img">
          <defs>
            <mask id="seam-mask">
              <rect x="0" y="0" width="120" height="120" fill="white" />
              <line x1="60" y1="48" x2="60" y2="72" stroke="black" stroke-width="14" stroke-linecap="round"/>
            </mask>
          </defs>
          <path d="M 22 92 L 22 28 L 60 60 L 98 28 L 98 92" fill="none" stroke="var(--logo-path-stroke)" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" mask="url(#seam-mask)"/>
          <circle cx="60" cy="48" r="5.5" fill="var(--logo-path-stroke)"/>
          <circle cx="60" cy="72" r="5.5" fill="var(--logo-path-stroke)"/>
        </svg>
        <span class="brand-copy">
          <span class="brand-name">Meldjs.dev</span>
          <span class="brand-kicker">Micro-frontend engine</span>
        </span>
      </a>

      <nav class="topbar-nav" aria-label="Primary navigation">
        <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>
          <i data-lucide="book-open"></i>
          Docs
        </a>
        <a href="/core-api/" {% if "/core-api/" in page.url %}aria-current="page"{% endif %}>
          <i data-lucide="braces"></i>
          API
        </a>
        <a href="/plugins/" {% if "/plugins/" in page.url %}aria-current="page"{% endif %}>
          <i data-lucide="blocks"></i>
          Plugins
        </a>
        <a href="/architecture/" {% if "/architecture/" in page.url %}aria-current="page"{% endif %}>
          <i data-lucide="network"></i>
          Architecture
        </a>
        <a href="/bootcamp/" {% if "/bootcamp/" in page.url %}aria-current="page"{% endif %}>
          <i data-lucide="graduation-cap"></i>
          Bootcamp
        </a>
      </nav>

      <div class="topbar-tools">
        <label class="header-search" aria-label="Search documentation">
          <i data-lucide="search"></i>
          <span class="sr-only">Search documentation</span>
          <input type="search" placeholder="Search docs…" data-docs-filter aria-label="Search docs">
        </label>
        <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false">
          <i data-lucide="sun"></i>
        </button>
        <a class="icon-button" href="https://github.com/meldjs/meld" aria-label="GitHub repository" target="_blank" rel="noopener">
          <i data-lucide="github"></i>
        </a>
        <button class="icon-button mobile-menu-button" type="button" data-sidebar-toggle aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="docs-nav">
          <i data-lucide="menu"></i>
        </button>
      </div>
    </header>

    {# ── Shell ───────────────────────────────────────────────────── #}
    <div class="docs-shell">

      {# ── Left sidebar ────────────────────────────────────────── #}
      <aside class="docs-nav" id="docs-nav" aria-label="Documentation navigation">
        <div class="docs-nav-head">
          <div class="docs-nav-title">
            <i data-lucide="panel-left"></i>
            Documentation
          </div>
        </div>

        <nav class="category-nav" aria-label="Documentation sections">
          {% for category in collections.docsCategories %}
            <section class="nav-category" aria-labelledby="nav-cat-{{ category.id }}" {% if category.items | length == 0 %}hidden{% endif %}>
              <h2 id="nav-cat-{{ category.id }}">
                <a href="{{ category.indexUrl }}">{{ category.label }}</a>
              </h2>
              {% for item in category.items %}
                <a
                  href="{{ item.url }}"
                  {% if page.inputPath == item.inputPath %}aria-current="page"{% endif %}
                >
                  <i data-lucide="file-text"></i>
                  <span>{{ item.data.title or item.fileSlug }}</span>
                </a>
              {% endfor %}
            </section>
          {% endfor %}
        </nav>
      </aside>

      {# ── Content area ────────────────────────────────────────── #}
      <main class="docs-content" id="content" tabindex="-1">
        <div class="content-topline">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            {% for crumb in page.url | breadcrumbs %}
              {% if loop.last %}
                <span aria-current="page">{{ title or crumb.label }}</span>
              {% else %}
                <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                <i data-lucide="chevron-right"></i>
              {% endif %}
            {% endfor %}
          </nav>
          <a class="edit-link" href="https://github.com/meldjs/meld/edit/main/{{ page.inputPath }}" target="_blank" rel="noopener">
            <i data-lucide="pencil"></i>
            Edit this page
          </a>
        </div>

        {{ content | safe }}

        {% set previousPage = collections.docsNav | previousDoc(page.inputPath) %}
        {% set nextPage    = collections.docsNav | nextDoc(page.inputPath) %}
        {% if previousPage or nextPage %}
          <nav class="doc-pager" aria-label="Documentation pagination">
            {% if previousPage %}
              <a href="{{ previousPage.url }}" class="doc-pager-link" rel="prev">
                <span>← Previous</span>
                <strong>{{ previousPage.data.title or previousPage.fileSlug }}</strong>
              </a>
            {% else %}
              <span></span>
            {% endif %}
            {% if nextPage %}
              <a href="{{ nextPage.url }}" class="doc-pager-link doc-pager-link--next" rel="next">
                <span>Next →</span>
                <strong>{{ nextPage.data.title or nextPage.fileSlug }}</strong>
              </a>
            {% endif %}
          </nav>
        {% endif %}
      </main>

      {# ── Right TOC ───────────────────────────────────────────── #}
      <aside class="page-toc" aria-label="On this page">
        <div class="page-toc-title">
          <i data-lucide="list"></i>
          On This Page
        </div>
        <nav data-page-toc aria-label="Page sections"></nav>
        {# Recently viewed + recently edited panels injected by docs.js #}
      </aside>

    </div>{# /docs-shell #}

    {# ── Ctrl+K Search Modal ─────────────────────────────────────── #}
    <div
      id="search-modal"
      class="search-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Search documentation"
      hidden
    >
      <div class="search-dialog" role="document">

        {# Input row #}
        <div class="search-input-row">
          <span class="search-input-icon"><i data-lucide="search"></i></span>
          <input
            id="search-modal-input"
            type="search"
            placeholder="Search docs…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search documentation"
          >
          <span class="search-kbd">Esc</span>
          <button class="search-close-btn" id="search-modal-close" type="button" aria-label="Close search">
            <i data-lucide="x"></i>
          </button>
        </div>

        {# Three-column body: categories | results | preview #}
        <div class="search-body">
          <div class="search-col-categories" id="search-categories" aria-label="Categories"></div>
          <div class="search-col-results"    id="search-results"    role="listbox" aria-label="Search results"></div>
          <div class="search-col-preview"    id="search-preview"    aria-label="Result preview">
            <div class="search-hint">
              <i data-lucide="search"></i>
              <span>Type to search across all docs, API references, and anchors</span>
            </div>
          </div>
        </div>

        {# Footer hints #}
        <div class="search-footer" aria-hidden="true">
          <span class="search-footer-hint"><span class="search-kbd">↑↓</span> Navigate</span>
          <span class="search-footer-hint"><span class="search-kbd">↵</span> Go</span>
          <span class="search-footer-hint"><span class="search-kbd">Esc</span> Close</span>
          <span class="search-footer-hint"><span class="search-kbd">⌘K</span> Toggle</span>
        </div>

      </div>
    </div>{# /search-modal #}

    {# ── Footer ──────────────────────────────────────────────────── #}
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-heading head-brand">Meld.js</div>
          <p class="footer-brand-text">
            A 2kb browser runtime for reactive state, native custom elements, isolated widgets, and plugin-driven integration.
          </p>
          <div class="footer-social">
            <a href="https://github.com/meldjs/meld" aria-label="GitHub" target="_blank" rel="noopener">
              <i data-lucide="github"></i>
            </a>
            <a href="/releases/" aria-label="Releases changelog">
              <i data-lucide="tag"></i>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <div class="footer-heading head-docs">Resources</div>
          <div class="footer-links">
            <a href="/"           class="footer-link">Documentation</a>
            <a href="/core-api/"  class="footer-link">Core API</a>
            <a href="/plugins/"   class="footer-link">Plugin Library</a>
            <a href="/testing/"   class="footer-link">Testing</a>
            <a href="/releases/"  class="footer-link">Releases</a>
          </div>
        </div>

        <div class="footer-col">
          <div class="footer-heading head-social">Build Paths</div>
          <div class="footer-links">
            <a href="/installation/"          class="footer-link">Install</a>
            <a href="/bootcamp/"              class="footer-link">Bootcamp</a>
            <a href="/integrations/frontend/" class="footer-link">Frontend Integration</a>
            <a href="/integrations/backend/"  class="footer-link">Backend Integration</a>
            <a href="/architecture-kmel/"     class="footer-link">KMEL Stack</a>
          </div>
        </div>

        <div class="footer-col">
          <div class="footer-heading head-sub">Local Development</div>
          <p class="footer-brand-text">Run the Eleventy docs server with live reload from the repository root.</p>
          <code class="footer-command">npm run docs:serve</code>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© 2026 Meld.js. Released under the MIT License.</span>
        <div class="footer-bottom-links">
          <a href="/roadmap/">Roadmap</a>
          <a href="/deployment/">Deployment</a>
          <a href="/faq/">FAQ</a>
        </div>
      </div>
    </footer>

  </body>
</html>
