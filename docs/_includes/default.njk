{% from "components/release-banner.njk" import releaseBanner %}
{% from "components/topbar.njk" import topbar %}
{% from "components/sidebar.njk" import sidebar %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/doc-pager.njk" import docPager %}
{% from "components/toc.njk" import toc %}
{% from "components/search-modal.njk" import searchModal %}
{% from "components/footer.njk" import footer %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or "Docs" }} | Meld.js</title>
    <meta name="description" content="{{ description or 'Meld.js documentation — a 2kb micro-frontend engine for reactive state, native custom elements, and plugin-driven integration.' }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/prism-meld.css">
    <link rel="stylesheet" href="/assets/docs.css">
    {# Block flash of wrong theme #}
    <script>document.documentElement.dataset.theme = localStorage.getItem('meld-docs-theme') || 'dark';</script>
    {# Third-party libs #}
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" defer></script>
    {# Docs JS #}
    <script src="/assets/docs.js" defer></script>
  </head>
  <body>
    {# Ambient background grid #}
    <div class="space-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>

    {{ releaseBanner(releaseBanner) }}

    {{ topbar(page, isLanding=false) }}

    {# ── Shell ───────────────────────────────────────────────────── #}
    <div class="docs-shell">

      {{ sidebar(page, collections) }}

      {# ── Content area ────────────────────────────────────────── #}
      <main class="docs-content" id="content" tabindex="-1">
        <div class="content-topline">
          {{ breadcrumbs(page, title) }}
          <a class="edit-link" href="https://github.com/meldjs/meld/edit/main/{{ page.inputPath }}" target="_blank" rel="noopener">
            <i data-lucide="pencil"></i>
            Edit this page
          </a>
        </div>

        {{ content | safe }}

        {{ docPager(page, collections) }}
      </main>

      {{ toc() }}

    </div>{# /docs-shell #}

    {{ searchModal() }}

    {{ footer() }}

  </body>
</html>
