  State["meldState()"] --> Bindings["Template Bindings"]
  Bindings --> DOM["Targeted DOM Update"]
  Plugins["Plugin Context"] --> Ctx["Component Context"]
  Ctx --> Bindings
  CE["Custom Element\nlifecycle"] --> Ctx{% endhighlight %}
