<script>
document.addEventListener('DOMContentLoaded', () => {
  const editor = document.getElementById('code-editor');
  const preview = document.getElementById('preview-frame');
  const runBtn = document.getElementById('run-btn');
  const presetSelect = document.getElementById('example-presets');

  const presets = {
    counter: `// 1. Define reactive state
const state = meldState({ count: 0 });

// 2. Define custom element component
defineMeld('simple-counter', (el) => {
  const increment = () => state.count++;

  return meldHtml\`
    <div>
      <h3>Count: \${() => state.count}</h3>
      <button onclick="\${increment}">Increment</button>
    </div>
  \`;
});

// 3. Render the custom element
document.getElementById('app').innerHTML = '<simple-counter></simple-counter>';`,

    todolist: `// 1. Define reactive state
const state = meldState({
  todos: [
    { id: 1, text: 'Learn Meld.js core reactivity' },
    { id: 2, text: 'Build a custom element component' }
  ],
  newText: ''
});

// 2. Define todo list component
defineMeld('todo-list', (el) => {
  const addTodo = (e) => {
    e.preventDefault();
    if (!state.newText.trim()) return;
    state.todos = [...state.todos, { id: Date.now(), text: state.newText }];
    state.newText = '';
  };

  const removeTodo = (id) => {
    state.todos = state.todos.filter(t => t.id !== id);
  };

  return meldHtml\`
    <form onsubmit="\${addTodo}">
      <input 
        type="text" 
        value="\${() => state.newText}" 
        oninput="\${e => state.newText = e.target.value}" 
        placeholder="Add task..." 
      />
      <button type="submit">Add</button>
    </form>
    
    <ul>
      \${meld.list(
        () => state.todos,
        t => t.id,
        t => meldHtml\`
          <li>
            \${t.text} 
            <button style="background:#dc2626; margin-left:0.5rem; padding:0.25rem 0.5rem;" onclick="\${() => removeTodo(t.id)}">x</button>
          </li>
        \`
      )}
    </ul>
  \`;
});

// 3. Render component
document.getElementById('app').innerHTML = '<todo-list></todo-list>';`,

    computed: `// 1. Define reactive state
const state = meldState({
  firstName: 'John',
  lastName: 'Doe'
});

// 2. Define derived reactive value
const fullName = computed(() => \`\${state.firstName} \${state.lastName}\`);

// 3. Define component
defineMeld('user-profile', (el) => {
  return meldHtml\`
    <div>
      <input type="text" value="\${() => state.firstName}" oninput="\${e => state.firstName = e.target.value}" placeholder="First Name" />
      <input type="text" value="\${() => state.lastName}" oninput="\${e => state.lastName = e.target.value}" placeholder="Last Name" />
      
      <h2>Welcome, \${fullName}!</h2>
    </div>
  \`;
});

// 4. Render component
document.getElementById('app').innerHTML = '<user-profile></user-profile>';`
  };

  const loadPreset = (name) => {
    editor.value = presets[name] || '';
    runCode();
  };

  const MELD_CDN = 'https://unpkg.com/@meldjs/meld@latest/dist/meld.core.esm.js';

  const runCode = () => {
    const code = editor.value;

    // Build the iframe HTML as a plain string — no template literal
    // so esbuild never sees user code as part of a JS expression.
    const html = [
      '<!DOCTYPE html><html><head><meta charset="utf-8"><style>',
      'body{font-family:system-ui,-apple-system,sans-serif;color:#f3f4f6;background:#111827;padding:1.5rem;margin:0}',
      'button{background:#2563eb;color:white;border:none;padding:0.5rem 1rem;border-radius:0.375rem;cursor:pointer;font-weight:500;transition:background 0.2s}',
      'button:hover{background:#1d4ed8}',
      'input{background:#1f2937;border:1px solid #374151;color:white;padding:0.5rem;border-radius:0.375rem;margin-bottom:1rem;outline:none}',
      'ul{padding-left:1.25rem;margin-top:1rem}li{margin-bottom:0.5rem}',
      '</style></head><body><div id="app"></div>',
      '<script type="module">',
      'import{defineMeld,meldState,meldHtml,onMount,computed,meld}from"' + MELD_CDN + '";',
      'window.defineMeld=defineMeld;window.meldState=meldState;window.meldHtml=meldHtml;',
      'window.onMount=onMount;window.computed=computed;window.meld=meld;',
      'setTimeout(()=>{try{',
      code,
      '}catch(e){document.getElementById("app").innerHTML="<pre style=\'color:#ef4444;background:#1f2937;padding:1rem;border-radius:0.375rem;\'>Error: "+e.message+"</pre>";}},50);',
      '<\/script></body></html>'
    ].join('\n');

    // Inject via Blob URL to avoid document.write cross-origin restrictions
    const blob = new Blob([html], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const old = preview.src;
    preview.src = url;
    // Revoke previous blob URL after navigation
    if (old && old.startsWith('blob:')) URL.revokeObjectURL(old);
  };

  // Event Listeners
  runBtn.addEventListener('click', runCode);
  presetSelect.addEventListener('change', (e) => loadPreset(e.target.value));

  // Initialize
  loadPreset('counter');
});
</script>
