{
  "name": "meld-vscode",
  "displayName": "Meld.js Support",
  "description": "Rich developer tooling for Meld.js, including syntax highlighting, snippets, and typescript-plugin LSP completions.",
  "version": "1.0.0",
  "publisher": "meld-js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meldjs/meld.git"
  },
  "bugs": {
    "url": "https://github.com/meldjs/meld/issues"
  },
  "homepage": "https://github.com/meldjs/meld/tree/main/meld-vscode#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "scripts": {
    "package": "npm run copy-lsp && vsce package",
    "copy-lsp": "rm -rf node_modules/meld-lsp && mkdir -p node_modules/meld-lsp/out && cp ../meld-lsp/package.json node_modules/meld-lsp/ && cp ../meld-lsp/out/index.js node_modules/meld-lsp/out/"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.19.0"
  },
  "dependencies": {
    "typescript-template-language-service-decorator": "^2.3.1",
    "vscode-html-languageservice": "^5.1.0",
    "vscode-languageserver-types": "^3.17.0"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "meld.injection",
        "path": "./syntaxes/meld-injection.json",
        "injectTo": ["source.js", "source.jsx", "source.ts", "source.tsx"],
        "embeddedLanguages": { "meta.embedded.block.html": "html" }
      }
    ],
    "snippets": [
      { "language": "javascript", "path": "./snippets/javascript.json" },
      { "language": "javascript", "path": "./snippets/html.json" },
      { "language": "typescript", "path": "./snippets/html.json" },
      { "language": "javascriptreact", "path": "./snippets/html.json" },
      { "language": "typescriptreact", "path": "./snippets/html.json" },
      { "language": "html", "path": "./snippets/html.json" }
    ],
    "typescriptServerPlugins": [
      { "name": "meld-lsp", "enableForWorkspaceTypeScriptVersions": true }
    ]
  }
}
